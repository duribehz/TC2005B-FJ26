<%- include('includes/_header.ejs') %>

<h1><%= página %></h1>

<% if (error) { %>
    <p style="color: red;">Lo sentimos, esta página o canción no existe.</p>
<% } else if (agradecimiento) { %>
    <p>Gracias por tu aporte a la cultura musical.</p>
    <a href="/musica/lista">Volver a la lista</a>
<% } else if (detalles) { %>
    <p>Información detallada del archivo local.</p>
<% } else { %>
    <%- include('includes/_form.ejs') %>
<% } %>

<%- include('includes/_footer.ejs') %>