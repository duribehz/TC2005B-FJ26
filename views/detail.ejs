<%- include ('includes/_header.ejs') %>

<section class="section" style="background-color: #0d0d0d; min-height: 100vh;">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-6">

        <div class="card" style="background: linear-gradient(160deg, #1c1c3a, #12122a); border: 1px solid #ffffff18; border-radius: 20px; overflow: hidden;">

          <% if (song.image) { %>
            <div class="card-image">
              <figure class="image is-16by9">
                <img src="/uploads/<%= song.image %>" alt="<%= song.name %>"
                  style="object-fit: cover; width: 100%; height: 100%;">
              </figure>
            </div>
          <% } else { %>
            <div style="height: 200px; background: linear-gradient(135deg, #f5a623, #e84393); display: flex; align-items: center; justify-content: center;">
              <span style="font-size: 5rem;">🎵</span>
            </div>
          <% } %>

          <div class="card-content">

            <h2 class="title has-text-white is-2 mb-1"><%= song.name %></h2>
            <p class="subtitle has-text-grey-light mb-4">🎤 <%= song.artist %></p>

            <hr style="background-color: #ffffff18; height: 1px; border: none;">

            <div class="mt-4">
              <div class="mb-3">
                <span class="tag is-warning is-light is-rounded is-medium">
                  🎼 <%= song.genre_name %>
                </span>
              </div>
              <div class="mb-3">
                <p class="has-text-grey-light is-size-7 mb-1">ENLACE</p>
                <a href="<%= song.link %>" target="_blank" class="has-text-warning">
                  🔗 <%= song.link %>
                </a>
              </div>
            </div>

          </div>

          <footer class="card-footer" style="border-top: 1px solid #ffffff18;">
            <a href="/song/update/<%= song.song_id %>" class="card-footer-item has-text-info" style="font-weight: 600;">
              ✏️ Modificar
            </a>
            <a href="/song/delete/<%= song.song_id %>" class="card-footer-item has-text-danger" style="font-weight: 600;">
              🗑️ Eliminar
            </a>
          </footer>

        </div>

        <div class="has-text-centered mt-5">
          <a href="/song/list" class="button is-dark is-rounded">
            ← Volver a la lista
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<%- include ('includes/_footer.ejs') %>