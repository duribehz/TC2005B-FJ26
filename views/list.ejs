<%- include('includes/_header.ejs') %>

<main>
    <h2><%= pagina %></h2>

    <% if (songs.length > 0) { %>
        <ul>
            <% songs.forEach((song, index) => { %>
                <li>
                    <%= song.title %>
                    - <a href="/musica/detalle/<%= index %>">ver detalles</a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No hay canciones en tu lista todavía. ¡<a href="/musica/new">Añade una</a>!</p>
    <% } %>
</main>

<%- include('includes/_footer.ejs') %>