<%- include('includes/_header') %>
<form action="/user/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" >
    <div class="field">
        <label for="username" class="label">Nombre de usuario</label>
        <div class="control">
            <input id="username" name="username" class="input" type="text" placeholder="e.g Dario1234" required>
        </div>
    </div>
    <div class="field">
        <label for="password" class="label">Password</label>
        <div class="control">
            <input id="password" name="password" class="input" type="password" required>
        </div>
    </div>
    <input class="button is-primary" type="submit" value="Entrar">
</form> 
<h3>No tienes cuenta?</h3>
<a href="/user/signup">Crear cuenta</a>
<%- include('includes/_footer') %>